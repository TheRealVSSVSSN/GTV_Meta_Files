# Port to listen on
PORT=3000

# Directory containing .meta XML files
SOURCE_DIR=./data/meta

# Directory to write .json outputs
OUTPUT_DIR=./data/json

# Whether to convert all on startup (true/false)
AUTO_CONVERT_ON_START=false

# Daily automatic conversion (server local time)
DAILY_CONVERT_ENABLED=true
DAILY_CONVERT_AT=02:00
